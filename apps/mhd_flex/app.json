{
  "id": "mhd_flex",
  "title": "Flex Fuel",
  "description": "Ethanol content (Active and CAN) read from an MHD-flashed DME over the car's own diagnostic link, as two dials. Read-only; the addresses come from a ROM profile table",
  "version": "0.1.1",
  "vendor": "custom",
  "loggingId": "OA9E",
  "iconGlyph": "E85",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Flex Fuel",
      "buttons": [
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]
    },
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]
    }
  ],
  "config": {
    "dynamicDid": "F304",
    "pollMs": 500,
    "readTimeoutMs": 1500,
    "probeTimeoutMs": 3000,
    "redefineLimit": 3
  }
}
